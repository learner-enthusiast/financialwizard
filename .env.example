# Copy to .env.local (Next.js + Prisma CLI) and fill in. Never commit real values.

# --- Database (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=financialwizard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/financialwizard?schema=public

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From Clerk Dashboard > Webhooks > endpoint signing secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Logging: fatal | error | warn | info | debug | trace | silent ---
LOG_LEVEL=

# --- Research agent: tracing (neatlogs) ---
# Optional for the app (export is disabled when unset); required for `pnpm smoke trace`.
NEATLOGS_API_KEY=

# --- Research agent: LLM (LLM_PROVIDER=anthropic|openai|bedrock) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

# --- Research agent: vendor tools (optional until used) ---
SERPAPI_KEY=
CRUSTDATA_API_KEY=
FIRECRAWL_API_KEY=
SEC_USER_AGENT=

# --- Research agent: job runner (JOB_RUNNER=inngest|render) ---
JOB_RUNNER=inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
RENDER_API_KEY=
RENDER_WORKFLOW_NAME=

# --- Research agent: governance (optional) ---
ARMORIQ_API_KEY=
